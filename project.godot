; Engine configuration file.
config_version=5

[application]

config/name="Godot Motion Kit"
config/description="Motion graphics for Godot: frame-pure compositions, Remotion-exact springs, part-level SVG animation."
run/main_scene="res://demo/demo_menu.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray()

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
textures/canvas_textures/default_texture_filter=1
