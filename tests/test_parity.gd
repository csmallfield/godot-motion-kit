# MK against values computed by Remotion itself (tests/fixtures/remotion_parity.json,
# regenerated by tools/parity). Each test returns "" on success or a message.
extends RefCounted

const TOL := 1e-6
var fx: Dictionary

func _init() -> void:
	fx = JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/remotion_parity.json"))

func test_spring() -> String:
	var worst := 0.0
	var where := ""
	var n := 0
	for c in fx.spring:
		for i in c.frames.size():
			var got := MK.spring(float(c.frames[i]), 0.0, c.damping, c.stiffness, c.mass, c.fps)
			var d := absf(got - float(c.values[i]))
			n += 1
			if d > worst:
				worst = d
				where = "fps %s d %s k %s m %s f %s: %s vs %s" % [c.fps, c.damping, c.stiffness, c.mass, c.frames[i], got, c.values[i]]
	print("        spring: %d values, worst |diff| %s" % [n, String.num_scientific(worst)])
	return "" if worst < TOL else "worst %s at %s" % [String.num_scientific(worst), where]

func test_bezier() -> String:
	var worst := 0.0
	var where := ""
	for c in fx.bezier:
		var e := MK.bezier(c.c[0], c.c[1], c.c[2], c.c[3])
		for i in c.xs.size():
			var d := absf(e.call(float(c.xs[i])) - float(c.values[i]))
			if d > worst:
				worst = d
				where = "%s x=%s" % [c.name, c.xs[i]]
	print("        bezier: worst |diff| %s" % String.num_scientific(worst))
	return "" if worst < TOL else "worst %s at %s" % [String.num_scientific(worst), where]

func test_named_curves_match_fixture() -> String:
	var named := {ease = MK.ease_out, ease_in_out = MK.ease_in_out, ease_in_back = MK.ease_in_back, ease_out_back = MK.ease_out_back}
	for c in fx.bezier:
		if not named.has(c.name):
			continue
		for i in range(0, c.xs.size(), 10):
			if absf(named[c.name].call(float(c.xs[i])) - float(c.values[i])) > TOL:
				return "%s differs at %s" % [c.name, c.xs[i]]
	return ""

func test_interpolate() -> String:
	var ef := {linear = MK.linear, ease = MK.ease_out, ease_in_out = MK.ease_in_out, ease_in_back = MK.ease_in_back, quad = MK.ease_in_quad}
	var worst := 0.0
	for c in fx.interpolate:
		for i in c.xs.size():
			var got := MK.interp(float(c.xs[i]), c.inputs, c.outputs, ef[c.easing])
			worst = maxf(worst, absf(got - float(c.values[i])))
	print("        interpolate: worst |diff| %s" % String.num_scientific(worst))
	return "" if worst < TOL else "worst %s" % String.num_scientific(worst)

func test_rand_shake_typed() -> String:
	for r in fx.rand:
		if absf(MK.rand(r[0]) - float(r[1])) > 1e-9:
			return "rand(%s) = %s, want %s" % [r[0], MK.rand(r[0]), r[1]]
	for r in fx.shake:
		var v := MK.shake(r[0], 86.0, 120.0, 10.0)
		# Vector2 is single precision, so compare to float32 resolution.
		if absf(v.x - float(r[1])) > 1e-4 or absf(v.y - float(r[2])) > 1e-4:
			return "shake at %s" % r[0]
	for r in fx.typed:
		var t := MK.typed("> verify ............ ok", r[0], 150.0, 120.0)
		if t != r[1]:
			return "typed at %s: '%s' vs '%s'" % [r[0], t, r[1]]
	return ""

func test_interpolate_extend() -> String:
	var ef := {linear = MK.linear, quad = MK.ease_in_quad}
	for c in fx.interpolate_extend:
		for i in c.xs.size():
			var got := MK.interp(float(c.xs[i]), c.inputs, c.outputs, ef[c.easing], MK.Extrapolate.EXTEND, MK.Extrapolate.EXTEND)
			if absf(got - float(c.values[i])) > 1e-6:
				return "%s x=%s: %s vs %s" % [c.easing, c.xs[i], got, c.values[i]]
	return ""

func test_timecode() -> String:
	if MK.timecode(61 * 30 + 5) != "00:01:01:05":
		return MK.timecode(61 * 30 + 5)
	if MK.timecode(-3) != "00:00:00:00":
		return MK.timecode(-3)
	return ""
